{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "SERVER_PORT",
    "APP_PORT",
    "CHAT_WIDGET_PORT"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "JWT_SECRET",
        "NODE_ENV",
        "SERVER_PORT",
        "APP_PORT",
        "CHAT_WIDGET_PORT",
        "VITE_PORT",
        "VITE_CHAT_WIDGET_PORT",
        "CORS_ORIGINS",
        "DATABASE_URL",
        "VITE_SERVER_URL",
        "VITE_CHAT_WIDGET_SERVER_URL",
        "VITE_CHAT_WIDGET_WEBSOCKET_URL",
        "PROXY",
        "VITE_CLOUDFLARE_TURNSTILE_SITE_KEY",
        "VITE_APP_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_CALLBACK_URL",
        
        // Resend email service env variables
        "RESEND_API_KEY",
        "RESEND_FROM_EMAIL",


        // Redis env variable
        "REDIS_HOST",
        "REDIS_PORT"
      ]
    },
    "prisma:migrate": {
      "cache": false,
      "interactive": true,
      "env": [
        "DATABASE_URL"
      ]
    },
    "prisma:generate": {
      "cache": false
    },
    "prisma:studio": {
      "cache": false,
      "persistent": true,
      "interactive": true
    },
    "prisma:reset": {
      "cache": false,
      "interactive": true,
      "env": ["DATABASE_URL"]
    }
  }
}