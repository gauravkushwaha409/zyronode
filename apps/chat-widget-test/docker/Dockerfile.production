# apps/chat-widget-test/docker/Dockerfile.production
#
# Release image for chat-widget-test (staging, uat, production). Build context is the
# repo root (monorepo workspace). The APP_ENV build arg picks
# env/.env.<APP_ENV> (default: production):
#
#   docker build -f apps/chat-widget-test/docker/Dockerfile.production .
#   docker build -f apps/chat-widget-test/docker/Dockerfile.production --build-arg APP_ENV=staging .
#
# docker/docker-compose.{staging,uat,production}.yml wire this up.
#
# Notes:
# - pnpm comes from corepack and resolves to the root package.json
#   `packageManager` field (pnpm@12.4.2, lockfile v9).
# - .dockerignore excludes **/dist and **/src/generated, so the Nest build
#   and `prisma generate` always run fresh inside the image.
# - env/.env.<APP_ENV> is NOT excluded by .dockerignore (the `**/.env`
#   pattern only matches files named exactly `.env`), so build stages can
#   COPY it — vite (envDir ../../env, --mode APP_ENV) and prisma.config.ts
#   (env/.env.$APP_ENV) both read it at build time. Runtime stages never
#   copy it; compose injects runtime env via `env_file`.
# - Vite bakes VITE_* values into the bundles at BUILD time, so the app /
#   chat-widget-test images must be rebuilt after changing public URLs.
# - No port fallbacks anywhere: APP_PORT / CHAT_WIDGET_PORT / SERVER_PORT
#   must be provided via env (compose passes them from env/.env.<APP_ENV>);
#   the container fails fast with a clear message if one is missing.

ARG APP_ENV=production

# ── base ──────────────────────────────────────────────────────────
FROM node:22-alpine AS base
ARG APP_ENV
ENV APP_ENV=${APP_ENV}
RUN corepack enable
WORKDIR /app

# ── chat-widget-test: builder ─────────────────────────────────────
FROM base AS builder

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

COPY turbo.json tsconfig.json ./
COPY apps/chat-widget-test ./apps/chat-widget-test
COPY packages ./packages

# build-time env: bakes __APP_CONFIG__ (server/websocket url, org id)
COPY env/.env.${APP_ENV} ./env/

RUN pnpm --filter chat-widget-test build --mode ${APP_ENV}

# ── chat-widget-test: runtime (vite preview) ───────────────────────
FROM base AS runtime

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

COPY --from=builder /app/apps/chat-widget-test/dist ./apps/chat-widget-test/dist
COPY --from=builder /app/apps/chat-widget-test/vite.config.ts /app/apps/chat-widget-test/index.html /app/apps/chat-widget-test/tsconfig.json ./apps/chat-widget-test/

# CHAT_WIDGET_PORT must be provided via env (no fallback).
# Unlike `app`, this vite.config defines `preview.proxy`, so /v1 and
# /socket.io are forwarded server-side to VITE_CHAT_WIDGET_SERVER_URL.
EXPOSE 4000

CMD sh -c "pnpm --filter chat-widget-test preview -- --host 0.0.0.0 --port ${CHAT_WIDGET_PORT:?CHAT_WIDGET_PORT must be provided}"
