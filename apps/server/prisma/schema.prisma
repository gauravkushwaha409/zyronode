generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String?
  firstName String?
  lastName  String?
  profile   String?
  googleId  String? @unique
  authProvider String @default("email")
  isEmailVerified Boolean @default(false)

  theme          String?  @default("light")
  referralSource String?
  isOnboarded    Boolean  @default(false)

  // relation with organization 
  organizations OrganizationMember[]
  lastOrgId     String?
  lastOrg       Organization?        @relation("UserLastOrg", fields: [lastOrgId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Organization {
  id       String               @id @default(uuid())
  name     String
  website  String? // their public website
  email    String               @unique
  phone    String?
  industry String?
  plan     PlanType             @default(FREE)
  isActive Boolean              @default(true)
  visitors Visitor[]
  members  OrganizationMember[]

  // back-relation for lastOrg
  lastOrgUsers User[] @relation("UserLastOrg")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

// junction table ==> one user => many orgs; one org => many users
model OrganizationMember {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Visitor {
  id             String       @id @default(uuid())
  organizationId String // which org's website they visited
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String?
  email       String?
  phone       String?
  ipAddress   String?
  sourceUrl   String? // page they landed on
  utmSource   String? // google, facebook, etc.
  utmMedium   String?
  utmCampaign String?

  status VisitorStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([email])
  @@map("visitors")
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum VisitorStatus {
  NEW // just captured, no action taken
  REVIEWED // sales rep has seen them
  CONVERTED // became a lead
  IGNORED // not a fit, dismissed
}
