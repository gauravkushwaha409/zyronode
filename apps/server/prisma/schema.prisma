generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String  @id @default(uuid())
  email           String  @unique
  password        String?
  firstName       String?
  lastName        String?
  profile         String?
  googleId        String? @unique
  authProvider    String  @default("email")
  isEmailVerified Boolean @default(false)

  theme          String? @default("light")
  referralSource String?
  isOnboarded    Boolean @default(false)

  // relation with organization
  organizations OrganizationMember[]
  lastOrgId     String?
  lastOrg       Organization?        @relation("UserLastOrg", fields: [lastOrgId], references: [id])

  assignedVisitors Visitor[]     @relation("VisitorAssignedAgent")
  visitorNotes     VisitorNote[] @relation("VisitorNoteAuthor")
  deletedConversations Conversation[] @relation("ConversationDeletedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Organization {
  id            String               @id @default(uuid())
  name          String
  website       String? // their public website
  phone         String?
  industry      String?
  plan          PlanType             @default(FREE)
  isActive      Boolean              @default(true)
  visitors      Visitor[]
  members       OrganizationMember[]
  conversations Conversation[]

  // back-relation for lastOrg
  lastOrgUsers User[] @relation("UserLastOrg")

  roles Role[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

// junction table ==> one user => many orgs; one org => many users
model OrganizationMember {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  roleId String?
  role   Role?  @relation(fields: [roleId], references: [id], onDelete: SetNull)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

// Global, platform-level permission registry. Seeded idempotently on server
// boot; `key` (module.resource.verb) is the stable identity.
model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  module      String

  roles RolePermission[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("permissions")
}

// Access roles. `organizationId = null` marks a system role (platform-wide,
// seeded, immutable); custom roles are organization-scoped and editable.
model Role {
  id             String           @id @default(uuid())
  organizationId String?
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isSystem       Boolean          @default(false)

  permissions RolePermission[]
  members     OrganizationMember[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@map("roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Visitor {
  id             String       @id @default(uuid())
  organizationId String // which org's website they visited
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String?
  email       String?
  phone       String?
  ipAddress   String?
  sourceUrl   String? // page they landed on
  utmSource   String? // google, facebook, etc.
  utmMedium   String?
  utmCampaign String?

  status VisitorStatus @default(NEW)

  // identity — externalId is the stable id the widget assigns a browser
  externalId   String?
  visitCount   Int     @default(1)
  isIdentified Boolean @default(false)

  // presence. isOnline/activeDuration/currentPage are refreshed by the
  // widget heartbeat; lastSeenAt is the durable fallback.
  isOnline       Boolean   @default(false)
  currentPage    String?
  activeDuration Int       @default(0) // seconds in the current session
  lastSeenAt     DateTime?

  // device
  device     String?
  deviceType String?
  browser    String?
  os         String?

  // geo (resolved from ipAddress)
  country     String?
  countryCode String?
  city        String?
  region      String?
  regionName  String?
  timezone    String?
  latitude    Float?
  longitude   Float?

  assignedAgentId String?
  assignedAgent   User?   @relation("VisitorAssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  notes         VisitorNote[]
  pageVisits    VisitorPageVisit[]
  conversations Conversation[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, externalId])
  @@index([organizationId])
  @@index([email])
  @@index([organizationId, isOnline])
  @@index([organizationId, lastSeenAt(sort: Desc)])
  @@map("visitors")
}

model VisitorNote {
  id        String  @id @default(uuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("VisitorNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  content String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([visitorId])
  @@index([visitorId, createdAt(sort: Desc)])
  @@map("visitor_notes")
}

// One row per page view, so "top pages" and the visited-sites timeline
// can be aggregated without stuffing history onto the visitor row.
model VisitorPageVisit {
  id        String  @id @default(uuid())
  visitorId String
  visitor   Visitor @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  url             String
  pageTitle       String?
  enteredAt       DateTime  @default(now()) @map("entered_at")
  leftAt          DateTime? @map("left_at")
  durationSeconds Int       @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([visitorId])
  @@index([visitorId, enteredAt(sort: Desc)])
  @@map("visitor_page_visits")
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum VisitorStatus {
  NEW // just captured, no action taken
  REVIEWED // sales rep has seen them
  CONVERTED // became a lead
  IGNORED // not a fit, dismissed
}

enum ConversationStatus {
  ACTIVE
  IDLE
  CLOSED
  PENDING
}

enum MessageSenderType {
  VISITOR
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  FILE
  INTERNAL_NOTE
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

model Conversation {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // optional link to the tracked visitor; visitorName/Email stay as the
  // denormalised fallback for conversations with no visitor row.
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)

  status       ConversationStatus @default(ACTIVE)
  channel      String             @default("web")
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  ipAddress    String?
  userAgent    String?
  sourceUrl    String?
  metadata     Json?

  messages Message[]

  deletedAt   DateTime? @map("deleted_at")
  deletedById String?   @map("deleted_by")
  deletedBy   User?     @relation("ConversationDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([visitorId])
  @@index([deletedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderType  MessageSenderType
  senderId    String?
  messageType MessageType       @default(TEXT)
  content     String

  replyToId String?
  replyTo   Message?  @relation("MessageReplies", fields: [replyToId], references: [id])
  replies   Message[] @relation("MessageReplies")

  status   MessageDeliveryStatus @default(SENT)
  isEdited Boolean               @default(false)
  editedAt DateTime?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([conversationId])
  @@index([conversationId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}
