generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String?
  firstName String?
  lastName  String?
  profile   String?
  googleId  String? @unique
  authProvider String @default("email")
  isEmailVerified Boolean @default(false)

  theme          String?  @default("light")
  referralSource String?
  isOnboarded    Boolean  @default(false)

  // relation with organization 
  organizations OrganizationMember[]
  lastOrgId     String?
  lastOrg       Organization?        @relation("UserLastOrg", fields: [lastOrgId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
}

model Organization {
  id       String               @id @default(uuid())
  name     String
  website  String? // their public website
  phone    String?
  industry String?
  plan     PlanType             @default(FREE)
  isActive Boolean              @default(true)
  visitors Visitor[]
  members  OrganizationMember[]
  sessions Session[]

  // back-relation for lastOrg
  lastOrgUsers User[] @relation("UserLastOrg")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

// junction table ==> one user => many orgs; one org => many users
model OrganizationMember {
  id             String @id @default(uuid())
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now()) @map("joined_at")

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_members")
}

model Visitor {
  id             String       @id @default(uuid())
  organizationId String // which org's website they visited
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String?
  email       String?
  phone       String?
  ipAddress   String?
  sourceUrl   String? // page they landed on
  utmSource   String? // google, facebook, etc.
  utmMedium   String?
  utmCampaign String?

  status VisitorStatus @default(NEW)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([email])
  @@map("visitors")
}

enum PlanType {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum VisitorStatus {
  NEW // just captured, no action taken
  REVIEWED // sales rep has seen them
  CONVERTED // became a lead
  IGNORED // not a fit, dismissed
}

enum SessionStatus {
  ACTIVE
  IDLE
  CLOSED
  PENDING
}

enum MessageSenderType {
  VISITOR
  AGENT
  SYSTEM
}

enum MessageType {
  TEXT
  FILE
  INTERNAL_NOTE
}

enum MessageDeliveryStatus {
  SENT
  DELIVERED
  READ
}

model Session {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  status         SessionStatus @default(ACTIVE)
  channel        String        @default("web")
  visitorName    String?
  visitorEmail   String?
  visitorPhone   String?
  ipAddress      String?
  userAgent      String?
  sourceUrl      String?
  metadata       Json?

  messages       Message[]

  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@map("sessions")
}

model Message {
  id             String                @id @default(cuid())
  sessionId      String
  session        Session               @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  senderType     MessageSenderType
  senderId       String?
  messageType    MessageType           @default(TEXT)
  content        String

  replyToId      String?
  replyTo        Message?              @relation("MessageReplies", fields: [replyToId], references: [id])
  replies        Message[]             @relation("MessageReplies")

  status         MessageDeliveryStatus @default(SENT)
  isEdited       Boolean               @default(false)
  editedAt       DateTime?

  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @updatedAt @map("updated_at")

  @@index([sessionId])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([senderId])
  @@map("messages")
}
