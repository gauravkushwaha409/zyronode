FROM node:22-alpine
RUN corepack enable && corepack prepare pnpm@11 --activate

WORKDIR /app

# ── manifests only -> install layer stays cached until deps change ──
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

# ── tooling & configs (source itself comes from bind mounts) ──
COPY turbo.json tsconfig.json ./

COPY apps/app/index.html \
     apps/app/vite.config.ts \
     apps/app/tsconfig.json \
     apps/app/components.json \
     ./apps/app/
COPY apps/app/public ./apps/app/public

COPY packages/api-client/tsconfig.json ./packages/api-client/tsconfig.json
COPY packages/form/tsconfig.json ./packages/form/tsconfig.json
COPY packages/hooks/tsconfig.json ./packages/hooks/tsconfig.json
COPY packages/icons/tsconfig.json ./packages/icons/tsconfig.json
COPY packages/query/tsconfig.json ./packages/query/tsconfig.json
COPY packages/sse/tsconfig.json ./packages/sse/tsconfig.json
COPY packages/text-editor/tsconfig.json ./packages/text-editor/tsconfig.json
COPY packages/ui/tsconfig.json ./packages/ui/tsconfig.json
COPY packages/websocket/tsconfig.json ./packages/websocket/tsconfig.json
COPY packages/typescript-config/base.json \
     packages/typescript-config/react-library.json \
     ./packages/typescript-config/

# Port is configurable via APP_PORT env (vite.config.ts reads APP_PORT, docker-compose maps ${APP_PORT})
EXPOSE 3000
