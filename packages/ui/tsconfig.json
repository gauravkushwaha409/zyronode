// packages/ui/tsconfig.json
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "paths": {
      "#lib/*": [
        "./src/lib/*"
      ],
      "#components/*": [
        "./src/components/*"
      ],
      "#hooks/*": [
        "./src/hooks/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
}