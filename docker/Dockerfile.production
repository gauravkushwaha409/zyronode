# docker/Dockerfile.production
#
# Production images for zyro-chat. Build context is the repo root.
# One file, one target per service (mirrors the per-app Dockerfile.dev files):
#
#   docker build -f docker/Dockerfile.production --target server .
#   docker build -f docker/Dockerfile.production --target app .
#   docker build -f docker/Dockerfile.production --target chat-widget-test .
#
# docker-compose.production.yml wires these targets up.
#
# Notes:
# - pnpm comes from corepack and resolves to the root package.json
#   `packageManager` field (pnpm@12.4.2, lockfile v9).
# - .dockerignore excludes **/dist and **/src/generated, so the Nest build
#   and `prisma generate` always run fresh inside the image.
# - env/.env.production is NOT excluded by .dockerignore (the `**/.env`
#   pattern only matches files named exactly `.env`), so build stages can
#   COPY it to ./.env — vite (envDir ../../) and prisma.config.ts both
#   read env from the repo root at build time.
# - Vite bakes VITE_* values into the bundles at BUILD time, so the app /
#   chat-widget-test images must be rebuilt after changing public URLs.
# - No port fallbacks anywhere: APP_PORT / CHAT_WIDGET_PORT / SERVER_PORT
#   must be provided via env (compose passes them from env/.env.production);
#   the container fails fast with a clear message if one is missing.

# ── base ──────────────────────────────────────────────────────────
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ── server: builder ───────────────────────────────────────────────
FROM base AS server-builder

# manifests only -> install layer stays cached until deps change
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

# tooling + server source (no bind mounts in prod — everything is baked in)
COPY turbo.json tsconfig.json ./
COPY apps/server ./apps/server

# build-time env for prisma.config.ts dotenv (../../.env)
COPY env/.env.production ./.env

RUN pnpm --filter server prisma:generate
RUN pnpm --filter server build

# ── server: runtime ───────────────────────────────────────────────
FROM base AS server

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# Full install (not --prod): the `prisma` CLI is a devDependency and is
# needed at container start for `prisma migrate deploy`.
RUN pnpm install --frozen-lockfile

COPY --from=server-builder /app/apps/server/dist ./apps/server/dist
COPY --from=server-builder /app/apps/server/src/generated ./apps/server/src/generated
COPY --from=server-builder /app/apps/server/package.json ./apps/server/package.json
# schema + migrations + datasource config for `prisma migrate deploy`
COPY apps/server/prisma ./apps/server/prisma
COPY apps/server/prisma.config.ts ./apps/server/

# Port must be provided via SERVER_PORT env (main.ts reads SERVER_PORT)
EXPOSE 8000

CMD sh -c "pnpm --filter server prisma:deploy && node apps/server/dist/src/main.js"

# ── app: builder ──────────────────────────────────────────────────
FROM base AS app-builder

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

COPY turbo.json tsconfig.json ./
# app resolves @package/* via tsconfigPaths, so all package sources are needed
COPY apps/app ./apps/app
COPY packages ./packages

# build-time env: vite reads envDir ../../ and bakes __SERVER_URL__ /
# __PROXY_ENABLED__ + VITE_* into the bundle
COPY env/.env.production ./.env

RUN pnpm --filter app build

# ── app: runtime (vite preview) ───────────────────────────────────
FROM base AS app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

# Full install: `vite preview` needs vite + the vite.config.ts plugin
# imports (tailwindcss, tanstack router, react plugin) = devDependencies.
RUN pnpm install --frozen-lockfile

COPY --from=app-builder /app/apps/app/dist ./apps/app/dist
COPY --from=app-builder /app/apps/app/vite.config.ts /app/apps/app/index.html /app/apps/app/tsconfig.json /app/apps/app/components.json ./apps/app/
COPY --from=app-builder /app/apps/app/public ./apps/app/public

# NOTE: apps/app/vite.config.ts defines proxy only under `server` (dev),
# not under `preview`. Production therefore runs with PROXY=false and the
# browser calls the absolute VITE_SERVER_URL directly (server CORS allows
# the VITE_APP_URL origin). APP_PORT must be provided via env (no fallback).
EXPOSE 3000

CMD sh -c "pnpm --filter app preview -- --host 0.0.0.0 --port ${APP_PORT:?APP_PORT must be provided}"

# ── chat-widget-test: builder ─────────────────────────────────────
FROM base AS chat-widget-test-builder

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

COPY turbo.json tsconfig.json ./
COPY apps/chat-widget-test ./apps/chat-widget-test
COPY packages ./packages

# build-time env: bakes __APP_CONFIG__ (server/websocket url, org id)
COPY env/.env.production ./.env

RUN pnpm --filter chat-widget-test build

# ── chat-widget-test: runtime (vite preview) ───────────────────────
FROM base AS chat-widget-test

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY apps/app/package.json ./apps/app/
COPY apps/server/package.json ./apps/server/
COPY apps/chat-widget-test/package.json ./apps/chat-widget-test/
COPY packages/api-client/package.json ./packages/api-client/
COPY packages/chat-widget/package.json ./packages/chat-widget/
COPY packages/form/package.json ./packages/form/
COPY packages/hooks/package.json ./packages/hooks/
COPY packages/icons/package.json ./packages/icons/
COPY packages/query/package.json ./packages/query/
COPY packages/sse/package.json ./packages/sse/
COPY packages/text-editor/package.json ./packages/text-editor/
COPY packages/ui/package.json ./packages/ui/
COPY packages/websocket/package.json ./packages/websocket/
COPY packages/typescript-config/package.json ./packages/typescript-config/

RUN pnpm install --frozen-lockfile

COPY --from=chat-widget-test-builder /app/apps/chat-widget-test/dist ./apps/chat-widget-test/dist
COPY --from=chat-widget-test-builder /app/apps/chat-widget-test/vite.config.ts /app/apps/chat-widget-test/index.html /app/apps/chat-widget-test/tsconfig.json ./apps/chat-widget-test/

# CHAT_WIDGET_PORT must be provided via env (no fallback).
# Unlike `app`, this vite.config defines `preview.proxy`, so /v1 and
# /socket.io are forwarded server-side to VITE_CHAT_WIDGET_SERVER_URL.
EXPOSE 4000

CMD sh -c "pnpm --filter chat-widget-test preview -- --host 0.0.0.0 --port ${CHAT_WIDGET_PORT:?CHAT_WIDGET_PORT must be provided}"
