{
  "name": "turbo-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm docker:up && pnpm wait-for-db && turbo dev",
    "dev:frontend": "turbo dev --filter frontend",
    "dev:backend": "pnpm docker:up && pnpm wait-for-db && turbo dev --filter backend",
    "build": "turbo build",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "wait-for-db": "node scripts/wait-for-db.mjs",
    "db:migrate": "turbo run prisma:migrate --filter backend",
    "db:studio": "turbo run prisma:studio --filter backend",
    "db:generate": "turbo run prisma:generate --filter backend"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "zod": "3.25.3"
    }
  }
}