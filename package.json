{
  "name": "turbo-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter app",
    "dev:server": "turbo dev --filter server",
    "dev:chat-widget": "turbo dev --filter chat-widget-test",
    "build": "turbo build",
    "check-types": "turbo run check-types",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "docker:development:build": "docker compose --env-file env/.env.development -f docker/docker-compose.development.yml build",
    "docker:development:up": "docker compose --env-file env/.env.development -f docker/docker-compose.development.yml up -d",
    "docker:development:start": "docker compose --env-file env/.env.development -f docker/docker-compose.development.yml up -d --build",
    "docker:development:down": "docker compose --env-file env/.env.development -f docker/docker-compose.development.yml down",
    "docker:development:logs": "docker compose --env-file env/.env.development -f docker/docker-compose.development.yml logs -f",
    "docker:development:reset": "docker compose --env-file env/.env.development -f docker/docker-compose.development.yml down -v && docker compose --env-file env/.env.development -f docker/docker-compose.development.yml up -d",
    "docker:staging:build": "docker compose --env-file env/.env.staging -f docker/docker-compose.staging.yml build",
    "docker:staging:up": "docker compose --env-file env/.env.staging -f docker/docker-compose.staging.yml up -d",
    "docker:staging:start": "docker compose --env-file env/.env.staging -f docker/docker-compose.staging.yml up -d --build",
    "docker:staging:down": "docker compose --env-file env/.env.staging -f docker/docker-compose.staging.yml down",
    "docker:staging:logs": "docker compose --env-file env/.env.staging -f docker/docker-compose.staging.yml logs -f",
    "docker:uat:build": "docker compose --env-file env/.env.uat -f docker/docker-compose.uat.yml build",
    "docker:uat:up": "docker compose --env-file env/.env.uat -f docker/docker-compose.uat.yml up -d",
    "docker:uat:start": "docker compose --env-file env/.env.uat -f docker/docker-compose.uat.yml up -d --build",
    "docker:uat:down": "docker compose --env-file env/.env.uat -f docker/docker-compose.uat.yml down",
    "docker:uat:logs": "docker compose --env-file env/.env.uat -f docker/docker-compose.uat.yml logs -f",
    "docker:production:build": "docker compose --env-file env/.env.production -f docker/docker-compose.production.yml build",
    "docker:production:up": "docker compose --env-file env/.env.production -f docker/docker-compose.production.yml up -d",
    "docker:production:start": "docker compose --env-file env/.env.production -f docker/docker-compose.production.yml up -d --build",
    "docker:production:down": "docker compose --env-file env/.env.production -f docker/docker-compose.production.yml down",
    "docker:production:logs": "docker compose --env-file env/.env.production -f docker/docker-compose.production.yml logs -f",
    "wait-for-db": "node scripts/wait-for-db.mjs",
    "prisma:migrate": "turbo run prisma:migrate --filter server",
    "prisma:generate": "pnpm --filter server prisma:generate",
    "prisma:deploy": "pnpm --filter server prisma:deploy",
    "prisma:reset": "pnpm --filter server prisma:reset --force",
    "prisma:reset:hard": "pnpm --filter server exec prisma migrate reset --force && pnpm prisma:seed",
    "prisma:seed": "pnpm --filter server prisma:seed",
    "prisma:studio": "turbo run prisma:studio --filter server",
    "resource": "pnpm --filter server exec nest generate resource"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "turbo": "^2.9.14",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=18"
  }
}