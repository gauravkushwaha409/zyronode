{
  "name": "turbo-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter app",
    "dev:server": "turbo dev --filter server",
    "build": "turbo build",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:reset": "docker compose down -v && docker compose up -d",
    "wait-for-db": "node scripts/wait-for-db.mjs",
    "prisma:migrate": "turbo run prisma:migrate --filter server",
    "prisma:deploy": "pnpm --filter server prisma:deploy",
    "prisma:studio": "turbo run prisma:studio --filter server",
    "prisma:generate": "turbo run prisma:generate --filter server",
    "resource": "pnpm --filter server exec nest generate resource"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.9",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  },
  "pnpm": {
    "overrides": {
      "react": "19.2.6",
      "react-dom": "19.2.6",
      "zod": "3.25.3",
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}