{
  "name": "turbo-repo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "dev:app": "turbo dev --filter app",
    "dev:server": "turbo dev --filter server",
    "dev:chat-widget": "turbo dev --filter chat-widget-test",
    "build": "turbo build",
    "check-types": "turbo run check-types",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "docker:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:dev:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "wait-for-db": "node scripts/wait-for-db.mjs",
    "prisma:migrate": "turbo run prisma:migrate --filter server",
    "prisma:generate": "pnpm --filter server prisma:generate",
    "prisma:deploy": "pnpm --filter server prisma:deploy",
    "prisma:seed": "pnpm --filter server prisma:seed",
    "prisma:studio": "turbo run prisma:studio --filter server",
    "resource": "pnpm --filter server exec nest generate resource"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "turbo": "^2.9.14",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=18"
  }
}