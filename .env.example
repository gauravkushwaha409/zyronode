# ─── Postgres ───────────────────────────────
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=mydb

# ─── pgAdmin ───────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# ─── Ports (single source of truth) ─────────
# Change these ports to run services on different ports.
# After changing, restart `pnpm dev` or `docker compose` to apply.
SERVER_PORT=8000
# FRONTEND
APP_PORT=3000
CHAT_WIDGET_PORT=4000

# ─── Backend ────────────────────────────────
DATABASE_URL=postgresql://admin:admin@localhost:5432/mydb
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=7d

# ─── Frontend ───────────────────────────────
# VITE_SERVER_URL=http://server:8000  # Docker internal
VITE_SERVER_URL=http://localhost:${SERVER_PORT}
# If VITE_SERVER_URL is empty, the apps will auto-derive it from SERVER_PORT.

PROXY=true
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=0x4AAAAAADRZsbNnkMXAuHaX
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x4AAAAAADRZsZ45QSbLmaO2LUHTc2_aZD8
VITE_APP_URL=http://localhost:${APP_PORT}

# ─── Google OAuth ───────────────────────────
GOOGLE_CLIENT_ID=463135468326-nptcece0hvi8564jscmtjnlu8j4q20sg.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:${SERVER_PORT}/api/v1/auth/google/callback

# ─── Resend (Email OTP) ─────────────────────
RESEND_API_KEY=xxx
RESEND_FROM_EMAIL=onboarding@resend.dev

# ─── ML Service ────────────────────────────
ML_SERVICE_URL=http://ml-service:8001

# ─── Redis ──────────────────────────────────
REDIS_HOST=redis

# ─── Chat Widget ────────────────────────────
VITE_ORGANIZATION_ID=f95d4ede-71a0-46c9-a3d2-d1f56609cd01
VITE_CHAT_WIDGET_SERVER_URL=http://localhost:${SERVER_PORT}
VITE_CHAT_WIDGET_WEBSOCKET_URL=http://localhost:${SERVER_PORT}

# ─── LocalStack ─────────────────────────────
# Get token from https://app.localstack.cloud (Auth Tokens page).
LOCALSTACK_AUTH_TOKEN=xxx
LOCALSTACK_DOCKER_NAME=localstack-main
DEBUG=0
PERSISTENCE=0
LOCALSTACK_VOLUME_DIR=./volume

# ─── S3 (file uploads, LocalStack in dev) ───
# Docker (server container): http://localstack:4566
# Running server on host (pnpm dev, not docker): http://localhost:4566
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=zyro-chat-uploads
AWS_REGION=us-east-1
# Base URL clients use to fetch uploaded files back; defaults to S3_ENDPOINT if unset.
S3_PUBLIC_URL=http://localhost:4566
